# -----------------------------------------------------------------------------
#  CREDENCIAIS / TOKENS  (preencher no onboarding - NENHUMA recebida ainda)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# ADVBOX - sistema juridico do escritorio, SE ele usar (a confirmar no onboarding).
ADVBOX_API_TOKEN=
ASAAS_API_TOKEN=
ASAAS_BASE_URL=https://api.asaas.com/v3
ZAPSIGN_API_TOKEN=
ATENDE_DIREITO_TOKEN=
